# Shared hook cases. tests/run.sh runs every record against hooks/<hook>.sh and tests/run.ps1
# against hooks/<hook>.ps1, so both implementations answer the same contract.
#
# Format (parsed line by line by both runners, no dependencies):
# - One record per block; blocks are separated by one or more blank lines. A line starting with
#   `#` is a comment. Every other line is `field=value`, split at the first `=`; the value runs
#   verbatim to the end of the line (no quoting, no trimming; a trailing CR is dropped).
# - Fields; `case` and `hook` are required, the rest optional, `+` marks a repeatable field:
#     case=<description>      printed on failure
#     hook=<name>             hooks/<name>.sh or hooks/<name>.ps1
#     part=<argument>         the one argument passed to the hook
#     user-conf=<line> +      one line of ~/.claude/guild.conf, HOME pointed at a scratch dir
#     project-conf=<line> +   one line of <project>/.claude/guild.conf, CLAUDE_PROJECT_DIR pointed
#                             at a scratch dir that also holds a copy of fixtures/project/emoji.md
#     agents-copy=yes         CLAUDE_PLUGIN_ROOT pointed at a scratch dir holding a copy of agents/
#                             and of hooks/lib/ (the hooks source their libraries from the root)
#     env=<NAME>=<value> +    set for this case
#     unset=<NAME> +          removed from the environment for this case
#     payload=<json>          stdin, sent without a trailing newline; empty when absent
#     exit=<n>                the exit code
#     stderr=<text>           stderr contains text
#     stderr-equals=<text>    stderr equals text
#     stdout=<text>           stdout contains text
#     stdout-lacks=<text>     stdout does not contain text
#     stdout-equals=<text>    stdout equals text (an empty value: stdout is empty)
#     stdout-under=<n>        stdout plus one newline is under n bytes
# - Captured stdout and stderr lose their trailing newlines before any comparison.
# - Placeholders, replaced in every value once the environment is set: %NL% a newline,
#   %FIXTURES% the tests/fixtures directory, %PROJECT% the CLAUDE_PROJECT_DIR of the case,
#   %ROOT% the repository as the hooks render it (forward slashes), agents-copy cases included.
# - Environment before each case: CLAUDE_PLUGIN_ROOT the repository, CLAUDE_PROJECT_DIR
#   fixtures/project, HOME fixtures/home (no guild.conf), CLAUDE_PLUGIN_OPTION_GIT_HANDLING and
#   every CLAUDE_PLUGIN_OPTION_<AGENT>_MODEL / _EFFORT unset. Setup order: user-conf,
#   project-conf, agents-copy, env, unset.
# - A record is one case; it passes when every expectation holds.
#
# render-agents cases expect the shipped frontmatter (the plugin.json option defaults) in agents/.

case=render-agents: no option set prints nothing
hook=render-agents
agents-copy=yes
exit=0
stdout-equals=

case=render-agents: a differing model prints the notice
hook=render-agents
agents-copy=yes
env=CLAUDE_PLUGIN_OPTION_BUILDER_MODEL=sonnet
exit=0
stdout-equals=GUILD AGENTS RENDERED: builder model=sonnet effort=medium. Run /reload-plugins to apply.

case=render-agents: model and effort of one agent in one run
hook=render-agents
agents-copy=yes
env=CLAUDE_PLUGIN_OPTION_REVIEWER_MODEL=sonnet
env=CLAUDE_PLUGIN_OPTION_REVIEWER_EFFORT=low
exit=0
stdout-equals=GUILD AGENTS RENDERED: reviewer model=sonnet effort=low. Run /reload-plugins to apply.

case=render-agents: several agents listed in agent order
hook=render-agents
agents-copy=yes
env=CLAUDE_PLUGIN_OPTION_SCRIBE_EFFORT=max
env=CLAUDE_PLUGIN_OPTION_INVESTIGATOR_MODEL=inherit
exit=0
stdout-equals=GUILD AGENTS RENDERED: investigator model=inherit effort=medium; scribe model=sonnet effort=max. Run /reload-plugins to apply.

case=render-agents: values equal to the frontmatter print nothing
hook=render-agents
agents-copy=yes
env=CLAUDE_PLUGIN_OPTION_BUILDER_MODEL=opus
env=CLAUDE_PLUGIN_OPTION_BUILDER_EFFORT=medium
exit=0
stdout-equals=

case=render-agents: an unknown model is ignored
hook=render-agents
agents-copy=yes
env=CLAUDE_PLUGIN_OPTION_BUILDER_MODEL=gpt
exit=0
stdout-equals=

case=render-agents: an unknown effort is ignored
hook=render-agents
agents-copy=yes
env=CLAUDE_PLUGIN_OPTION_ARCHITECT_EFFORT=extreme
exit=0
stdout-equals=

case=render-agents: a value differing only in case is ignored
hook=render-agents
agents-copy=yes
env=CLAUDE_PLUGIN_OPTION_BUILDER_MODEL=Sonnet
exit=0
stdout-equals=

case=render-agents: two allowed words in one value are ignored
hook=render-agents
agents-copy=yes
env=CLAUDE_PLUGIN_OPTION_BUILDER_MODEL=opus sonnet
exit=0
stdout-equals=

case=render-agents: a value carrying sed syntax is ignored
hook=render-agents
agents-copy=yes
env=CLAUDE_PLUGIN_OPTION_BUILDER_MODEL=sonnet/;s/^/x/
exit=0
stdout-equals=

case=render-agents: a valid effort renders next to an invalid model
hook=render-agents
agents-copy=yes
env=CLAUDE_PLUGIN_OPTION_BUILDER_MODEL=gpt
env=CLAUDE_PLUGIN_OPTION_BUILDER_EFFORT=low
exit=0
stdout-equals=GUILD AGENTS RENDERED: builder model=opus effort=low. Run /reload-plugins to apply.

case=render-agents: unset plugin root prints nothing
hook=render-agents
env=CLAUDE_PLUGIN_OPTION_BUILDER_MODEL=sonnet
unset=CLAUDE_PLUGIN_ROOT
exit=0
stdout-equals=

case=render-agents: libraries missing under CLAUDE_PLUGIN_ROOT prints nothing and exits 0
hook=render-agents
env=CLAUDE_PLUGIN_OPTION_BUILDER_MODEL=sonnet
env=CLAUDE_PLUGIN_ROOT=/nonexistent/guild-plugin-root
exit=0
stdout-equals=
stderr-equals=
