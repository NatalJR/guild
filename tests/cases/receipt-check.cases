# Shared hook cases. tests/run.sh runs every record against hooks/<hook>.sh and tests/run.ps1
# against hooks/<hook>.ps1, so both implementations answer the same contract.
#
# Format (parsed line by line by both runners, no dependencies):
# - One record per block; blocks are separated by one or more blank lines. A line starting with
#   `#` is a comment. Every other line is `field=value`, split at the first `=`; the value runs
#   verbatim to the end of the line (no quoting, no trimming; a trailing CR is dropped).
# - Fields; `case` and `hook` are required, the rest optional, `+` marks a repeatable field:
#     case=<description>      printed on failure
#     hook=<name>             hooks/<name>.sh or hooks/<name>.ps1
#     part=<argument>         the one argument passed to the hook
#     user-conf=<line> +      one line of ~/.claude/guild.conf, HOME pointed at a scratch dir
#     project-conf=<line> +   one line of <project>/.claude/guild.conf, CLAUDE_PROJECT_DIR pointed
#                             at a scratch dir that also holds a copy of fixtures/project/emoji.md
#     agents-copy=yes         CLAUDE_PLUGIN_ROOT pointed at a scratch dir holding a copy of agents/
#                             and of hooks/lib/ (the hooks source their libraries from the root)
#     env=<NAME>=<value> +    set for this case
#     unset=<NAME> +          removed from the environment for this case
#     payload=<json>          stdin, sent without a trailing newline; empty when absent
#     exit=<n>                the exit code
#     stderr=<text>           stderr contains text
#     stderr-equals=<text>    stderr equals text
#     stdout=<text>           stdout contains text
#     stdout-lacks=<text>     stdout does not contain text
#     stdout-equals=<text>    stdout equals text (an empty value: stdout is empty)
#     stdout-under=<n>        stdout plus one newline is under n bytes
# - Captured stdout and stderr lose their trailing newlines before any comparison.
# - Placeholders, replaced in every value once the environment is set: %NL% a newline,
#   %FIXTURES% the tests/fixtures directory, %PROJECT% the CLAUDE_PROJECT_DIR of the case,
#   %ROOT% the repository as the hooks render it (forward slashes), agents-copy cases included.
# - Environment before each case: CLAUDE_PLUGIN_ROOT the repository, CLAUDE_PROJECT_DIR
#   fixtures/project, HOME fixtures/home (no guild.conf), CLAUDE_PLUGIN_OPTION_GIT_HANDLING and
#   every CLAUDE_PLUGIN_OPTION_<AGENT>_MODEL / _EFFORT unset. Setup order: user-conf,
#   project-conf, agents-copy, env, unset.
# - A record is one case; it passes when every expectation holds.

case=receipt-check: non-guild agent allowed
hook=receipt-check
payload={"session_id":"s","hook_event_name":"SubagentStop","stop_hook_active":false,"agent_type":"general-purpose","last_assistant_message":"I looked around and here is prose."}
exit=0

case=receipt-check: verified: allowed
hook=receipt-check
payload={"session_id":"s","hook_event_name":"SubagentStop","stop_hook_active":false,"agent_type":"guild:builder","last_assistant_message":"verified: build OK\nsrc/a.ts:1-9 change"}
exit=0

case=receipt-check: path:line row allowed
hook=receipt-check
payload={"session_id":"s","hook_event_name":"SubagentStop","stop_hook_active":false,"agent_type":"guild:investigator","last_assistant_message":"src/app/main.ts:12 defines run"}
exit=0

case=receipt-check: No issues. allowed
hook=receipt-check
payload={"session_id":"s","hook_event_name":"SubagentStop","stop_hook_active":false,"agent_type":"guild:reviewer","last_assistant_message":"No issues."}
exit=0

case=receipt-check: N findings. allowed
hook=receipt-check
payload={"session_id":"s","hook_event_name":"SubagentStop","stop_hook_active":false,"agent_type":"guild:reviewer","last_assistant_message":"3 findings.\n1. x"}
exit=0

case=receipt-check: token match is case-insensitive
hook=receipt-check
payload={"session_id":"s","hook_event_name":"SubagentStop","stop_hook_active":false,"agent_type":"guild:builder","last_assistant_message":"VERIFIED: ok"}
exit=0

case=receipt-check: prose blocked with excerpt
hook=receipt-check
payload={"session_id":"s","hook_event_name":"SubagentStop","stop_hook_active":false,"agent_type":"guild:builder","last_assistant_message":"I finished the work.\nverified: ok"}
exit=2
stderr=Got: "I finished the work.". Rewrite

case=receipt-check: agent type match is case-insensitive
hook=receipt-check
payload={"session_id":"s","hook_event_name":"SubagentStop","stop_hook_active":false,"agent_type":"GUILD:Builder","last_assistant_message":"Done, all good."}
exit=2
stderr=Receipt contract

case=receipt-check: stop_hook_active true allowed
hook=receipt-check
payload={"agent_type":"guild:builder","stop_hook_active":true,"last_assistant_message":"prose"}
exit=0

case=receipt-check: escaped newlines resolved before the first line
hook=receipt-check
payload={"session_id":"s","hook_event_name":"SubagentStop","stop_hook_active":false,"agent_type":"guild:builder","last_assistant_message":"\n\n  \r\n  plan: 3 files\nmore"}
exit=0

case=receipt-check: message absent allowed
hook=receipt-check
payload={"agent_type":"guild:builder","stop_hook_active":false}
exit=0

case=receipt-check: blank message allowed
hook=receipt-check
payload={"session_id":"s","hook_event_name":"SubagentStop","stop_hook_active":false,"agent_type":"guild:builder","last_assistant_message":"\n   \n"}
exit=0

case=receipt-check: malformed payload allowed
hook=receipt-check
payload={"agent_type":"guild:builder","last_assistant_message":"unterminated
exit=0

case=receipt-check: excerpt capped at 80 characters
hook=receipt-check
payload={"session_id":"s","hook_event_name":"SubagentStop","stop_hook_active":false,"agent_type":"guild:builder","last_assistant_message":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}
exit=2
stderr=Got: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa".

case=receipt-check: switch off allows
hook=receipt-check
user-conf=hooks.receipt_check = off
payload={"session_id":"s","hook_event_name":"SubagentStop","stop_hook_active":false,"agent_type":"guild:builder","last_assistant_message":"prose"}
exit=0

case=receipt-check: unset CLAUDE_PLUGIN_ROOT prints nothing and exits 0
hook=receipt-check
payload={"session_id":"s","hook_event_name":"SubagentStop","stop_hook_active":false,"agent_type":"guild:builder","last_assistant_message":"I looked around and here is prose."}
unset=CLAUDE_PLUGIN_ROOT
exit=0
stdout-equals=
stderr-equals=

case=receipt-check: libraries missing under CLAUDE_PLUGIN_ROOT prints nothing and exits 0
hook=receipt-check
payload={"session_id":"s","hook_event_name":"SubagentStop","stop_hook_active":false,"agent_type":"guild:builder","last_assistant_message":"I looked around and here is prose."}
env=CLAUDE_PLUGIN_ROOT=/nonexistent/guild-plugin-root
exit=0
stdout-equals=
stderr-equals=
